{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "labels": [
    "dependencies"
  ],
  "packageRules": [
    {
      "description": "Keep heavyweight scientific and AI dependencies grouped for review",
      "matchPackageNames": [
        "/^(torch|torchaudio|torchvision|transformers|sentence-transformers|bertopic|lancedb|docling)$/"
      ],
      "groupName": "heavy scientific ai stack"
    }
  ]
}

